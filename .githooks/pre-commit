#!/bin/sh

export PYTHONIOENCODING=utf-8

echo "🔄 [Pre-commit] Compiling HTML templates..."

if [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON_BIN=".venv/Scripts/python.exe"
elif [ -f "sync_config.py" ]; then
    PYTHON_BIN="python"
else
    PYTHON_BIN="python"
fi

$PYTHON_BIN sync_config.py

if [ $? -ne 0 ]; then
    echo "❌ [Pre-commit] sync_config.py failed! Aborting commit."
    exit 1
fi

git add docs/index.html docs/not-available.html package.json 2>/dev/null

echo "✅ [Pre-commit] Generated files staged successfully!"
exit 0