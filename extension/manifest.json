{
  "manifest_version": 3,
  "name": "patens",
  "version": "1.1.3",
  "description": "Sends web context to your local AI database.",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "extension/assets/icon16.png",
    "32": "extension/assets/icon32.png",
    "48": "extension/assets/icon48.png",
    "128": "extension/assets/icon128.png"
  },
  "action": {
    "default_title": "Capture PDF to Patens",
    "default_icon": {
      "16": "extension/assets/icon16.png",
      "32": "extension/assets/icon32.png",
      "48": "extension/assets/icon48.png",
      "128": "extension/assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "extension/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*/*"
      ],
      "run_at": "document_start",
      "css": [
        "extension/content/content.css"
      ],
      "js": [
        "extension/content/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/assets/*",
        "extension/viewer/*",
        "extension/content/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}