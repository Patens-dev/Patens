{
  "manifest_version": 3,
  "name": "patens",
  "version": "1.1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@patens.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "109.0"
    }
  },
  "description": "Sends web context to your local AI database.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage",
  ],
  "commands": {
    "toggle_search_palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Search and paste from patens"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "config.js",
        "utils.js",
        "cart.js",
        "palette.js",
        "injector.js",
        "main.js"
      ]
    }
  ]
}